{
  "name": "edit.gtfs.zone",
  "version": "0.0.0-development",
  "description": "A fast, simple editor for GTFS transit data - inspired by geojson.io",
  "main": "src/index.html",
  "type": "module",
  "scripts": {
    "version": "tsx scripts/get-version.ts",
    "prebuild": "tsx scripts/get-version.ts > .version",
    "dev": "vite",
    "start": "vite",
    "serve": "cd dist && live-server --host=localhost --port=8080",
    "build": "vite build",
    "build:watch": "rollup -c --watch",
    "build:rollup": "rollup -c",
    "generate-favicons": "./scripts/generate-favicons.sh",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run knip",
    "deploy": "npm run build && gh-pages -d dist",
    "knip": "knip",
    "lint": "eslint src/ --max-warnings 0",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "analyze-bundle": "npm run build && npx webpack-bundle-analyzer dist/bundle.js --mode static --open",
    "lighthouse": "lhci autorun",
    "audit": "audit-ci --config audit-ci.json",
    "perf-test": "npm run build && npm run lighthouse",
    "commit": "cz commit"
  },
  "keywords": [
    "gtfs",
    "transit",
    "editor",
    "transport",
    "map"
  ],
  "author": "gtfs.zone contributors",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.35.0",
    "@lhci/cli": "^0.15.1",
    "@types/clusterize.js": "^0.18.3",
    "@types/jsdom": "^28.0.1",
    "@types/jszip": "^3.4.0",
    "@types/node": "^24.12.2",
    "@types/papaparse": "^5.3.16",
    "audit-ci": "^7.1.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "gh-pages": "^6.3.0",
    "git-describe": "^4.1.1",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "knip": "^6.3.0",
    "lighthouse": "^12.8.2",
    "lint-staged": "^16.1.6",
    "node-fetch": "^3.3.2",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.13",
    "tslib": "^2.8.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7",
    "webpack-bundle-analyzer": "^4.10.2"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "clusterize.js": "^1.0.0",
    "daisyui": "^5.1.13",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "maplibre-gl": "^5.7.2",
    "papaparse": "^5.5.3",
    "zod": "^4.1.9"
  },
  "lint-staged": {
    "src/**/*.{js,ts,jsx,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{css,scss,html}": [
      "prettier --write"
    ]
  }
}
